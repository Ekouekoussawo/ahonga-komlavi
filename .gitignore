# Project root .gitignore

# Next.js (frontend/)
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel

# WordPress (app/)
app/wp-content/uploads/
app/wp-content/cache/
app/wp-content/upgrade/
app/wp-content/backup-*/
app/.htaccess
app/wp-config.php

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log

# Environment files
.env*.local
.env.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
build/
dist/

# Testing
coverage/
.nyc_output/

# Misc
*.pem
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions