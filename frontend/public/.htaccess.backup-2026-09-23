# .htaccess for Next.js Static Export on HostGator Shared Hosting
# Place in: /public_html/evangelisteahongankomlavi.com/.htaccess
#
# FIXED 2026-09-19: replaced deprecated Apache 2.2 auth directives
# (Order allow,deny / Deny from all) with Apache 2.4 equivalents.
# On modern Apache the 2.2 syntax is rejected outright, so the file was
# being served as plain text instead of being processed — which is why
# GET /wp/ returned the raw .htaccess contents.

# ============================================
# NEXT.JS STATIC EXPORT CONFIGURATION
# ============================================

# Enable rewrite engine
RewriteEngine On

# Ensure index.html is served for directory requests (trailingSlash: true)
DirectoryIndex index.html index.php

# Force HTTPS (if SSL is configured)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# CRITICAL FIX: HostGator shared hosting has mod_deflate conflicts.
# Let Apache/server handle compression at transport level, not via .htaccess.
# This prevents ERR_CONTENT_DECODING_FAILED errors on /sermons/, /about/, etc.

# ============================================
# SECURITY HEADERS
# ============================================

# Prevent MIME type sniffing
Header always set X-Content-Type-Options "nosniff"

# Prevent clickjacking
Header always set X-Frame-Options "SAMEORIGIN"

# XSS protection
Header always set X-XSS-Protection "1; mode=block"

# Referrer policy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions policy (adjust as needed)
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# ============================================
# CACHING FOR STATIC ASSETS
# ============================================

# Cache static assets for 1 year (Next.js uses content hashes)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Alternative cache control for _next/static assets (hashed filenames)
<FilesMatch "^_next/static/.*\.(js|css|png|jpg|jpeg|webp|avif|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Cache HTML files for shorter time (revalidate on deploy)
<FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# ============================================
# PROTECT SENSITIVE FILES
# ============================================

# Block access to hidden files
# Apache 2.4 syntax (the old "Order allow,deny / Deny from all" is rejected
# by modern Apache and causes the file to be served as plain text).
<Files ~ "^\.">
    Require all denied
</Files>

# Block access to backup files
<FilesMatch "\.(bak|backup|old|orig|swp|tmp)$">
    Require all denied
</FilesMatch>

# ============================================
# WORDPRESS COEXISTENCE (if WP is in subdirectory)
# ============================================

# If WordPress is installed at /wp/ or /blog/, these rules prevent conflicts
# Pass all /wp/ requests through to PHP without Next.js processing
RewriteCond %{REQUEST_URI} ^/wp/ [NC]
RewriteRule ^ - [L]

# ============================================
# PHP VERSION (HostGator specific)
# ============================================
# AddHandler application/x-httpd-php82 .php
# Or use MultiPHP Manager in cPanel

# ============================================
# CUSTOM ERROR PAGES
# ============================================
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html